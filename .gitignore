# Entorno virtual de Python
venv/

# Cachés de Python y pytest
__pycache__/
*.pyc
.pytest_cache/

# Archivos de salida (Excel generados, reportes)
output/
*.xlsx

# Carpetas de archivos subidos (nunca se guardan)
uploads/
tmp/

# Variables de entorno y claves (por si algún día se usan)
.env
.env.*

# Archivos del sistema y de editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Registros
*.log

# Archivos Zone.Identifier que Windows crea al copiar a WSL
*:Zone.Identifier
